PORT=3000
HOST=0.0.0.0
# hub = Pi live from LAN hub; history always uses cloud keys below
DATA_SOURCE=hub
# Ecowitt hub LAN address (when DATA_SOURCE=hub) — change at scout hut
ECOWITT_HUB_IP=
# Ecowitt cloud API — Pi History tab + future public site (never commit real values)
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_DEVICE_MAC=
# Allow /api/power endpoints to actually shut down / reboot (Pi only)
ALLOW_POWER_CONTROL=false
